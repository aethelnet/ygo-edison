# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=release
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),release)
  ocgcore_config = release
endif
ifeq ($(config),debug)
  ocgcore_config = debug
endif

PROJECTS := ocgcore

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

ocgcore:
ifneq (,$(ocgcore_config))
	@echo "==== Building ocgcore ($(ocgcore_config)) ===="
	@${MAKE} --no-print-directory -C . -f ocgcore.make config=$(ocgcore_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f ocgcore.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  release"
	@echo "  debug"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   ocgcore"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"